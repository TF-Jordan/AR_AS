%%{init: {'theme': 'base'}}%%

graph LR
    subgraph SOURCES["Sources de données"]
        API["API FastAPI<br/>(elastic-apm agent)"]
        WORKER["Celery Workers"]
        LOGS["Logs JSON<br/>(structlog)"]
    end

    subgraph COLLECTE["Collecte"]
        APM["APM Server<br/>:8200<br/>Traces & Transactions"]
    end

    subgraph STOCKAGE["Stockage & Indexation"]
        ES["Elasticsearch<br/>:9200<br/>xpack.security=true<br/>Single-node"]
    end

    subgraph VISUALISATION["Visualisation"]
        KIBANA["Kibana :5601<br/>• Discover (logs)<br/>• APM (traces)<br/>• Dashboards"]
        FLOWER["Flower :5555<br/>• Workers status<br/>• Task history<br/>• Queue depth"]
    end

    API -->|"Traces HTTP<br/>Transactions<br/>Erreurs"| APM
    WORKER -->|"Traces tâches"| APM
