    APM -->|"Index apm-*<br/>logs-apm*<br/>traces-apm*"| ES

    ES -->|"Query API"| KIBANA
    WORKER -->|"Via Redis broker"| FLOWER

    subgraph SECURITE["Sécurité"]
        SETUP["es-setup<br/>(conteneur éphémère)"]
    end

    SETUP -->|"Configure:<br/>kibana_system<br/>apm_user<br/>apm_writer role"| ES

    style SOURCES fill:#DBEAFE,stroke:#2563EB
    style COLLECTE fill:#FEF3C7,stroke:#F59E0B
    style STOCKAGE fill:#D1FAE5,stroke:#10B981
