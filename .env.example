# AR_AS RaaS Platform - Environment Configuration

# Application Settings
APP_NAME="AR_AS RaaS Platform"
APP_VERSION="2.0.0"
DEBUG=false
ENVIRONMENT=development

# API Settings
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ar_as_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embedding Model
EMBEDDING_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768

# Sentiment Model (Module 1)
SENTIMENT_MODEL_PATH=./models/distil-camembert-sentiment

# Recommendation Settings
DEFAULT_TOP_K=10
SIMILARITY_WEIGHT=0.6
AVAILABILITY_WEIGHT=0.25
REPUTATION_WEIGHT=0.15
CACHE_TTL_SECONDS=3600
SENTIMENT_SCORE_TOLERANCE=0.1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Security
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
