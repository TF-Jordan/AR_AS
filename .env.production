# ==============================================================================
# AR_AS Recommendation System - Production Environment Configuration
# ==============================================================================
# IMPORTANT: Copy this file to .env and update with your production values
# Never commit .env files to version control!
# ==============================================================================

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME=AR_AS Recommendation System
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ==============================================================================
# API CONFIGURATION
# ==============================================================================
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# ==============================================================================
# DATABASE - PostgreSQL
# ==============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_STRONG_PASSWORD
POSTGRES_DB=recommendation_db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# ==============================================================================
# CACHE - Redis
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis memory policy
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ==============================================================================
# MESSAGE BROKER - Celery
# ==============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Celery worker settings
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000

# ==============================================================================
# VECTOR DATABASE - Qdrant
# ==============================================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_VEHICLES=vehicles

# ==============================================================================
# MACHINE LEARNING MODELS
# ==============================================================================
# Embedding Model (Sentence Transformers)
EMBEDDING_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768
EMBEDDING_MODEL_PATH=./models/paraphrase-multilingual-mpnet-base-v2

# Sentiment Analysis Model (distil-camembert)
SENTIMENT_MODEL_PATH=./models/distil-camembert-sentiment

# Model cache directory
MODEL_CACHE_DIR=/app/.cache/models

# ==============================================================================
# RECOMMENDATION ENGINE SETTINGS
# ==============================================================================
DEFAULT_TOP_K=10
SIMILARITY_WEIGHT=0.6
AVAILABILITY_WEIGHT=0.25
REPUTATION_WEIGHT=0.15

# Cache settings
CACHE_TTL_SECONDS=3600
SENTIMENT_SCORE_TOLERANCE=0.1

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_ENDPOINT_ENABLED=true

# ==============================================================================
# SECURITY
# ==============================================================================
# IMPORTANT: Change this in production!
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_STRING_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS settings (adjust for production)
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true

# ==============================================================================
# LOGGING
# ==============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# Log file settings
LOG_TO_FILE=true
LOG_FILE_PATH=/app/logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ==============================================================================
# MONITORING - Elastic APM
# ==============================================================================
APM_ENABLED=true
APM_SERVER_URL=http://apm-server:8200
APM_SERVICE_NAME=ar-as-recommendation-api
APM_ENVIRONMENT=production

# APM sampling
APM_TRANSACTION_SAMPLE_RATE=1.0
APM_CAPTURE_BODY=all

# ==============================================================================
# MONITORING - Elasticsearch
# ==============================================================================
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# Elasticsearch JVM settings
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ==============================================================================
# MONITORING - Kibana
# ==============================================================================
KIBANA_HOST=kibana
KIBANA_PORT=5601
KIBANA_ENCRYPTION_KEY=CHANGE_ME_TO_A_32_CHARACTER_STRING_FOR_ENCRYPTION

# ==============================================================================
# MONITORING - Logstash
# ==============================================================================
LOGSTASH_HOST=logstash
LOGSTASH_BEATS_PORT=5044
LOGSTASH_TCP_PORT=5000
LOGSTASH_MONITORING_PORT=9600

# Logstash JVM settings
LS_JAVA_OPTS=-Xms512m -Xmx512m

# ==============================================================================
# CELERY FLOWER (Monitoring UI)
# ==============================================================================
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ==============================================================================
# DOCKER & DEPLOYMENT
# ==============================================================================
# Compose project name
COMPOSE_PROJECT_NAME=ar-as

# Docker registry (if using private registry)
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest

# ==============================================================================
# BACKUP & DISASTER RECOVERY
# ==============================================================================
# Backup schedule (cron format)
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================
# API workers (uvicorn)
API_WORKERS=4
API_WORKER_CLASS=uvicorn.workers.UvicornWorker

# Request timeout (seconds)
REQUEST_TIMEOUT=30
KEEPALIVE_TIMEOUT=65

# Max request size (bytes)
MAX_REQUEST_SIZE=10485760

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
ENABLE_API_DOCS=true
ENABLE_METRICS_ENDPOINT=true
ENABLE_HEALTHCHECK_ENDPOINT=true
ENABLE_CORS=true

# ==============================================================================
# EMAIL NOTIFICATIONS (if needed)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@ar-as.com

# Admin email for alerts
ADMIN_EMAIL=admin@ar-as.com

# ==============================================================================
# EXTERNAL SERVICES (if integrated)
# ==============================================================================
# Sentry for error tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ==============================================================================
# SSL/TLS (if using HTTPS)
# ==============================================================================
SSL_ENABLED=false
SSL_CERT_PATH=/certs/cert.pem
SSL_KEY_PATH=/certs/key.pem

# ==============================================================================
# TIMEZONE
# ==============================================================================
TZ=UTC
TIMEZONE=UTC

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Replace all CHANGE_ME values with strong, random strings
# 2. Use environment-specific passwords for databases
# 3. Enable SSL/TLS in production
# 4. Configure proper CORS origins
# 5. Set up proper backup strategies
# 6. Monitor logs and metrics regularly
# 7. Keep sensitive data in secrets management (e.g., AWS Secrets Manager, HashiCorp Vault)
# ==============================================================================
