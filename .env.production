# ==============================================================================
# AR_AS RaaS Platform - Production Environment Configuration
# ==============================================================================
# IMPORTANT: Copy this file to .env and update with your production values
# Never commit .env files to version control!
# ==============================================================================

# Application
APP_NAME=AR_AS RaaS Platform
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

# API
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=ar_as_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ML Models
EMBEDDING_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768
SENTIMENT_MODEL_PATH=./models/distil-camembert-sentiment

# Recommendation Engine
DEFAULT_TOP_K=10
CACHE_TTL_SECONDS=3600
SENTIMENT_SCORE_TOLERANCE=0.1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Security
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_API_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_STRING

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Docker
COMPOSE_PROJECT_NAME=ar-as
